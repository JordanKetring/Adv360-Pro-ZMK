#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
		#include "macros.dtsi"
		#include "version.dtsi"

		hm: homerow_mods {
			compatible = "zmk,behavior-hold-tap";
			label = "HOMEROW_MODS";
			#binding-cells = <2>;
			tapping-term-ms = <200>;
			quick_tap_ms = <175>;
			flavor = "tap-preferred";
			bindings = <&kp>, <&kp>;
		};
		plus_1: plus_1 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp PLUS>, <&kp N1>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        lbkt_2: left_bracket_2 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp N2>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        lbrc_3: left_brace_3 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LBRC>, <&kp N3>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        lpar_4: left_parenthesis_4 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LPAR>, <&kp N4>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        astrk_5: asterisk_5 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp ASTRK>, <&kp N5>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        equal_6: equal_6 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp EQUAL>, <&kp N6>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        rpar_7: right_parenthesis_7 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RPAR>, <&kp N7>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        rbrc_8: right_brace_8 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RBRC>, <&kp N8>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        rbkt_9: right_bracket_9 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RBKT>, <&kp N9>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        minus_0: minus_0 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp N0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        under_at: underscore_at_sign {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp UNDER>, <&kp AT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        excl_hash: exclamation_hash {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp EXCL>, <&kp HASH>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        prcnt_amps: percent_ampersand {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp PRCNT>, <&kp AMPS>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        copy_cut: copy_cut {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RC(C)>, <&kp RC(X)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        home_page_up: home_page_up {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp HOME>, <&kp PAGE_UP>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        end_page_down: end_page_down {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp END>, <&kp PAGE_DOWN>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
		compatible = "zmk,keymap";

		default_layer {
			display-name = "Base";
			bindings = <
				&kp CAPS  &plus_1   &lbkt_2  &lbrc_3  &lpar_4   &astrk_5 &tog 1                                                                &mo 4       &equal_6 &rpar_7  &rbrc_8   &rbkt_9       &minus_0       &under_at
				&kp TAB   &kp Q     &kp W    &kp E    &kp R     &kp T    &kp CARET                                                             &kp DLLR    &kp Y    &kp U    &kp I     &kp O         &kp P          &kp BSLH
				&kp ESC   &kp A     &kp S    &kp D    &kp F     &kp G    &excl_hash          &kp LCTRL &kp LALT  &kp RALT  &kp RCTRL           &prcnt_amps &kp H    &kp J    &kp K     &kp L         &kp SEMI       &kp SQT
				&kp LSHFT &kp Z     &kp X    &kp C    &kp V     &kp B                                   &kp RC(V) &kp LC(Y)                                &kp N    &kp M    &kp COMMA &kp DOT       &kp FSLH       &kp RSHFT
				&mo 2     &kp GRAVE &kp LGUI &kp LEFT &kp RIGHT                     &kp BSPC &kp DEL   &copy_cut &kp RC(Z) &kp ENTER &kp SPACE                      &kp DOWN &kp UP    &home_page_up &end_page_down &mo 2
			>;
		};
		keypad {
			display-name = "Kp";
			bindings = <
				&trans &trans &trans &trans &trans &trans  &trans                                              &trans &trans  &kp KP_NUM &kp KP_EQUAL &kp KP_DIVIDE &kp KP_MULTIPLY &trans
				&trans &trans &trans &trans &trans &trans  &trans                                              &trans &trans  &kp N7     &kp N8       &kp N9        &kp KP_MINUS    &trans
				&trans &trans &trans &trans &trans &trans  &trans        &trans &trans &trans &trans           &trans &trans  &kp N4     &kp N5       &kp N6        &kp KP_PLUS     &trans
				&trans &trans &trans &trans &trans &trans                       &trans &trans                         &trans  &kp N1     &kp N2       &kp N3        &kp KP_ENTER    &trans
				&trans &trans &trans &trans &trans                &trans &trans &trans &trans &trans &kp N0                   &trans     &trans       &kp DOT       &trans          &trans
			>;
		};
		fn {
			display-name = "Fn";
			bindings = <
				&kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6  &to 3                                            &mo 4  &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
				&trans &trans &trans &trans &trans &trans  &trans                                           &trans &trans &trans &trans &trans  &trans  &trans
				&trans &trans &trans &trans &trans &trans  &trans         &trans &trans &trans &trans       &trans &trans &trans &trans &trans  &trans  &trans
				&trans &trans &trans &trans &trans &trans                       &trans &trans                      &trans &trans &trans &trans  &trans  &trans
				&trans &trans &trans &trans &trans                &trans &trans &trans &trans &trans &trans               &trans &trans &trans  &trans  &trans
			>;
		};
		classic_layer {
			display-name = "Classic";
			bindings = <
				&kp EQUAL &kp N1    &kp N2   &kp N3   &kp N4   &kp N5 &to 0                                                           &mo 4 &kp N6 &kp N7    &kp N8    &kp N9   &kp N0   &kp MINUS
				&kp TAB   &kp Q     &kp W    &kp E    &kp R    &kp T  &none                                                           &none &kp Y  &kp U     &kp I     &kp O    &kp P    &kp BSLH
				&kp ESC   &kp A     &kp S    &kp D    &kp F    &kp G  &kp CAPS        &kp LCTRL &kp LALT &kp RALT  &kp RCTRL          &none &kp H  &kp J     &kp K     &kp L    &kp SEMI &kp SQT
				&kp LSHFT &kp Z     &kp X    &kp C    &kp V    &kp B                            &kp HOME &kp PG_UP                           &kp N  &kp M    &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
				&mo 2     &kp GRAVE &kp LGUI &kp LEFT &kp RIGHT               &kp BSPC &kp DEL  &kp END  &kp PG_DN &kp ENTER &kp SPACE              &kp DOWN &kp UP    &kp LBKT &kp RBKT &mo 2
			>;
		};
		mod {
			display-name = "Mod";
			bindings = <
				&none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                          &trans      &none &none      &none      &none &none &none
				&none &none        &none        &none        &none        &none        &bootloader                                                    &bootloader &none &none      &none      &none &none &none
				&none &none        &none        &none        &none        &none        &none             &none &none &bt BT_CLR &none                 &none       &none &none      &none      &none &none &none
				&none &none        &none        &none        &none        &none                                &none &none                                        &none &none      &none      &none &none &none
				&none &none        &none        &none        &none                                 &none &none &none &none &bl BL_TOG &rgb_ug RGB_TOG                   &bl BL_INC &bl BL_DEC &none &none &none
			>;
		};
		extra2 { 
			display-name = "Purple";
			status = "reserved";
		};
		extra3 { 
			display-name = "Cyan";
			status = "reserved";
		};
		extra4 { 
			display-name = "Yellow";
			status = "reserved";
		};
    };
};
